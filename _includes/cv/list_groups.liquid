<div class="cv-skill-groups">
  {% for content in entry.contents %}
    <div class="cv-skill-group">
      <div class="cv-skill-category">
        {% if content.icon %}<i class="{{ content.icon }}"></i> {% endif %}{{ content.category }}
      </div>
      <div class="cv-skill-items">
        {% for item in content.items %}{{ item.name }}{% unless forloop.last %}, {% endunless %}{% endfor %}
      </div>
    </div>
  {% endfor %}
</div>
